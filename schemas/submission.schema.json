{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AI Canvas optional submission metadata",
  "type":"object",
  "properties":{
    "schema_version":{"const":1},
    "task":{"type":"string","description":"Legacy metadata; task directory takes precedence"},
    "model":{"type":"string","description":"Legacy metadata; model directory takes precedence"},
    "model_version":{"type":"string","minLength":1},
    "revisions":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "properties":{
          "id":{"type":"string","minLength":1},
          "effective_from":{"type":"string","description":"ISO date or timezone-aware datetime; task defines activation semantics"},
          "directory":{"type":"string","minLength":1},
          "note":{"type":"string"}
        }
      }
    }
  }
}
